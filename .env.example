# Anthropic API key (required for the agent in phase 4+)
ANTHROPIC_API_KEY=sk-ant-...

# AI provider config (swap provider/model without code changes)
AI_PROVIDER=anthropic
AI_MODEL=claude-sonnet-4-5

# SQLite database path (relative to project root)
DB_PATH=./data/sales.db

# Google Maps API key (Geocoding API must be enabled)
# Used server-side only -- never exposed to the browser
GOOGLE_MAPS_API_KEY=
